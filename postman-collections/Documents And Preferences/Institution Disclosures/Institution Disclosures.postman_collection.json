                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/v1/institution-disclosures",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v1",
                "institution-disclosures"
              ]
            },
            "description": "Retrieve institution disclosures and identify a disclosure ID for subsequent requests.\n\nSaves `institution_disclosure_id`, `institution_disclosure_name` to the environment.\n\n```\nGET /v1/institution-disclosures\n```"
          },
          "response": []
        },
        {
          "name": "3. Update Institution Disclosure",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
