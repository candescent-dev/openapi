  "item": [
    {
      "name": "🔗 Create Institution Disclosure",
      "item": [
        {
          "name": "1. Generate Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const accessToken = jsonData.access_token;",
                  "",
                  "pm.environment.set(\"access_token\", accessToken);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "institutionId",
                "value": "{{institution_id}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{apigee_base_url}}/oauth2/v1/token",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "oauth2",
                "v1",
                "token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2a. [Option 1] Create Institution Disclosure - Custom with Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"institutionDisclosureName\": \"TEST_DISCLOSURE_{{$randomInt}}\",\n    \"institutionDisclosureStatus\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/v1/institution-disclosures",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v1",
                "institution-disclosures"
              ]
            },
            "description": "Create a custom institution disclosure identified by name.\n\n```\nPOST /v1/institution-disclosures\n```"
          },
          "response": []
        },
        {
          "name": "2b. [Option 2] Create Institution Disclosure - Custom with URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"institutionDisclosureName\": \"TEST_DISCLOSURE_{{$randomInt}}\",\n    \"institutionDisclosureData\": \"https://www.testbank.com/disclosure.pdf\",\n    \"institutionDisclosureDataType\": \"URL\",\n    \"institutionDisclosureStatus\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/v1/institution-disclosures",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v1",
                "institution-disclosures"
              ]
            },
            "description": "Create a custom institution disclosure that references an external URL.\n\n```\nPOST /v1/institution-disclosures\n```"
          },
          "response": []
        },
        {
          "name": "2c. [Option 3] Create Institution Disclosure - Online Statement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"institutionDisclosureName\": \"OLS\",\n    \"institutionDisclosureStatus\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/v1/institution-disclosures",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v1",
                "institution-disclosures"
              ]
            },
            "description": "Create an online-statement institution disclosure.\n\n```\nPOST /v1/institution-disclosures\n```"
          },
          "response": []
        }
      ],
      "description": "## 🔄 Create Institution Disclosure Flow\n\n| **Step** | Request Name | **Description** |\n| --- | --- | --- |\n| 1 | Generate Access Token | Obtain an access token using client credentials to authorize API requests. |\n| 2a | \\[Option 1\\] Create Institution Disclosure - Custom with Name | Create a disclosure with a custom name. |\n| 2b | \\[Option 2\\] Create Institution Disclosure - Custom with URL | Create a disclosure with a custom name and associated URL. |\n| 2c | \\[Option 3\\] Create Institution Disclosure - Online Statement | Create a disclosure specifically for online statements. |"
    },
