            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"institutionDisclosureId\": \"{{institution_disclosure_id}}\",\n    \"institutionDisclosureName\": \"{{institution_disclosure_name}}\",\n    \"institutionDisclosureData\": \"https://www.testbank.com/disclosure2.pdf\",\n    \"institutionDisclosureDataType\": \"URL\",\n    \"institutionDisclosureStatus\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/v1/institution-disclosures/{{institution_disclosure_id}}",
