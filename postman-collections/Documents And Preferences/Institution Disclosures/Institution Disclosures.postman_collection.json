    {
      "name": "🔗 Update Institution Disclosure",
      "item": [
        {
          "name": "1. Generate Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const accessToken = jsonData.access_token;",
                  "",
                  "pm.environment.set(\"access_token\", accessToken);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "institutionId",
                "value": "{{institution_id}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{apigee_base_url}}/oauth2/v1/token",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "oauth2",
                "v1",
                "token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. [Optional] Search for Institution Disclosure ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const defaultDisclosureName = pm.environment.get(\"default_disclosure_name\");",
                  "const institutionDisclosure = Array.isArray(jsonData.institutionDisclosures)",
                  "    ? jsonData.institutionDisclosures.find(disc => disc.institutionDisclosureName.includes(defaultDisclosureName))",
                  "    : null;",
                  "",
                  "pm.environment.set(\"institution_disclosure_id\", institutionDisclosure?.institutionDisclosureId ?? null);",
                  "pm.environment.set(\"institution_disclosure_name\", institutionDisclosure?.institutionDisclosureName ?? null);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
