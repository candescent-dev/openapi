  "item": [
    {
      "name": "🔗 Create User List Upload Job",
      "item": [
        {
          "name": "1. Generate Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const xml2js = require('xml2js');",
                  "",
                  "xml2js.parseString(pm.response.text(), function (error, jsonData) {",
                  "    if (error) {",
                  "        console.error(\"Error parsing XML:\", error);",
                  "        return;",
                  "    }",
                  "",
                  "    const accessToken = jsonData.token.access_token[0];",
                  "",
                  "    pm.environment.set(\"access_token\", accessToken);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "di_tid",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "di_fiid",
                "value": "{{institution_id}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/xml",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{apigee_base_url}}/v1/oauth/token",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v1",
                "oauth",
                "token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Create User List Upload Job",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "di_tid",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{user_list_name}}\",\n    \"description\": \"{{user_list_description}}\",\n    \"users\": [\n        \"{{member_number}}\"\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/pss/v1/fis/{{institution_id}}/audiences/userListJobs",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "pss",
                "v1",
                "fis",
                "{{institution_id}}",
                "audiences",
                "userListJobs"
              ]
            },
            "description": "Create a promotions suite user list upload job with a name, users, and optional description.\n\n```\nPOST /pss/v1/fis/{{institution_id}}/audiences/userListJobs\n```"
          },
          "response": []
        }
      ],
      "description": "## 🔄 **Create User List Upload Job** Flow\n\n| **Step** | Request Name | **Description** |\n| --- | --- | --- |\n| 1 | Generate Access Token | Obtain an access token using client credentials to authorize API requests. |\n| 2 | Create User List Upload Job | Create a user list upload job with name, users, and a custom description. |"
    },
