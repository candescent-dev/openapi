              "raw": "{\n    \"groupName\": \"{{experience_group_name}}\",\n    \"groupDescription\": \"Update description for new feature testing.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/v3/groups/{{experience_group_id}}",
