    {
      "name": "🔗 Update Experience Group",
      "item": [
        {
          "name": "1. Generate Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "pm.environment.set(\"access_token\", jsonData.access_token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "institutionId",
                "value": "{{institution_id}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{apigee_base_url}}/oauth2/v1/token",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "oauth2",
                "v1",
                "token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. [Optional] Search for Experience Group ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const targetName = (pm.environment.get(\"experience_group_name\") || \"\").trim();",
                  "const target = targetName.toLowerCase();",
                  "",
                  "function normalize(name) {",
                  "    return (name || \"\").trim().toLowerCase();",
                  "}",
                  "",
                  "function findGroup(body) {",
                  "    const groups = body.content || [];",
                  "    return groups.find(g => normalize(g.groupName) === target);",
                  "}",
                  "",
                  "function pageUrl(page) {",
                  "    const url = pm.request.url.toString();",
                  "    if (/[?&]page=\\d+/.test(url)) {",
                  "        return url.replace(/([?&]page=)\\d+/, `$1${page}`);",
                  "    }",
                  "    return url + (url.includes(\"?\") ? \"&\" : \"?\") + \"page=\" + page;",
                  "}",
                  "",
                  "function headers() {",
                  "    return {",
                  "        Authorization: `Bearer ${pm.environment.get(\"access_token\")}`,",
                  "        Accept: \"application/json\",",
                  "        transactionId: pm.variables.replaceIn(\"{{$guid}}\")",
                  "    };",
                  "}",
                  "",
                  "function setGroupId(group, page) {",
                  "    pm.environment.set(\"experience_group_id\", group.groupId);",
                  "    console.log(`Found on page ${page}. experience_group_id set to: ${group.groupId}`);",
                  "}",
                  "",
                  "const body = pm.response.json();",
                  "const match = findGroup(body);",
                  "",
                  "if (match) {",
                  "    setGroupId(match, 0);",
                  "    return;",
                  "}",
                  "",
                  "const totalPages = (body.page && body.page.totalPages) || 1;",
                  "",
                  "if (totalPages <= 1) {",
                  "    console.warn(`Experience group '${targetName}' not found.`);",
                  "    return;",
                  "}",
                  "",
                  "let found = false;",
                  "let pending = totalPages - 1;",
                  "",
                  "for (let page = 1; page < totalPages; page++) {",
                  "    pm.sendRequest(",
                  "        { url: pageUrl(page), method: \"GET\", header: headers() },",
                  "        (function (pageNum) {",
                  "            return function (err, res) {",
                  "                pending--;",
                  "",
                  "                if (found) {",
                  "                    return;",
                  "                }",
                  "",
                  "                if (err) {",
                  "                    console.error(`Error fetching page ${pageNum}:`, err);",
                  "                } else if (res.code !== 200) {",
                  "                    console.error(`Page ${pageNum} returned ${res.code}:`, res.text());",
                  "                } else {",
                  "                    const group = findGroup(res.json());",
                  "",
                  "                    if (group) {",
                  "                        found = true;",
                  "                        setGroupId(group, pageNum);",
                  "                        return;",
                  "                    }",
                  "                }",
                  "",
                  "                if (pending === 0 && !found) {",
                  "                    console.warn(`Experience group '${targetName}' not found.`);",
                  "                }",
                  "            };",
                  "        })(page)",
                  "    );",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{apigee_base_url}}/v3/groups?page=0&size=50&sort=groupName,asc",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v3",
                "groups"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "50"
                },
                {
                  "key": "sort",
                  "value": "groupName,asc"
                }
              ]
            },
            "description": "Retrieve active experience groups and identify the `experience_group_id` for subsequent requests.\n\nSaves `experience_group_id` to the environment.\n\n```\nGET /v3/groups?page=0&size=50&sort=groupName,asc\n```"
          },
          "response": []
        },
