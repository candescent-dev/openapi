  "item": [
    {
      "name": "🔗 Get Business Entitlements Limits",
      "item": [
        {
          "name": "1. Generate Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const accessToken = jsonData.access_token;",
                  "",
                  "pm.environment.set(\"access_token\", accessToken);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "institutionId",
                "value": "{{institution_id}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{apigee_base_url}}/oauth2/v1/token",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "oauth2",
                "v1",
                "token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. [Optional] Search for Business Entity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const businessTin = pm.environment.get(\"business_tin\");",
                  "const institutionCustomer = Array.isArray(jsonData.institutionCustomers)",
                  "    ? jsonData.institutionCustomers.find(cust => cust.memberNumber === businessTin)",
                  "    : null;",
                  "const companyId = Array.isArray(jsonData.additionalInfo?.entry)",
                  "    ? jsonData.additionalInfo.entry.find(ent => ent.key === \"companyId\")",
                  "    : null;",
                  "",
                  "pm.environment.set(\"institution_customer_id\", institutionCustomer?.institutionCustomerId ?? null);",
                  "pm.environment.set(\"business_id\", companyId?.value ?? null);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{apigee_base_url}}/v1/institution-users/{{business_user_login_id}}?userIdType=LOGIN_ID",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v1",
                "institution-users",
                "{{business_user_login_id}}"
              ],
              "query": [
                {
                  "key": "userIdType",
                  "value": "LOGIN_ID"
                }
              ]
            },
            "description": "Retrieve the business user's institution-user profile and identify `institution_customer_id` and `business_id` for subsequent requests.\n\nSaves `institution_customer_id`, `business_id` to the environment.\n\n```\nGET /v1/institution-users/{{business_user_login_id}}?userIdType=LOGIN_ID\n```"
          },
          "response": []
        },
