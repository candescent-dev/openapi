                  }
                ],
                "url": {
                  "raw": "{{apigee_base_url}}/bankingservices/v2/fis/{{institution_id}}/fiCustomers/{{retail_customer_id}}",
                  "host": [
                    "{{apigee_base_url}}"
                  ],
                  "path": [
                    "bankingservices",
                    "v2",
                    "fis",
                    "{{institution_id}}",
                    "fiCustomers",
                    "{{retail_customer_id}}"
                  ]
                },
                "description": "Retrieve profile information to confirm the access token is valid.\n\n```\nGET /bankingservices/v2/fis/{{institution_id}}/fiCustomers/{{retail_customer_id}}\n```"
              },
              "response": []
            }
          ],
          "description": "## 🔄 Retail User – Password Flow\n\n| **Step** | Request Name | **Description** |\n| --- | --- | --- |\n| 1 | Generate Access Token | Obtain an access token using the user's credentials. |\n| 2 | Get Profile Information | Access a protected resource using the access token. |",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "requests": {},
                "exec": [
                  "// Pre-request script to check if 'retail_user_password' environment variable is set",
                  "const password = pm.environment.get('retail_user_password');",
                  "",
                  "if (!password) {",
                  "    throw new Error(\"Environment variable 'retail_user_password' is not set. Please set it before running requests in this folder.\");",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// Pre-request script to check for required environment variables at the collection level",
              "const requiredVars = [",
              "    \"apigee_base_url\",",
              "    \"client_id\",",
              "    \"client_secret\",",
              "    \"institution_id\"",
              "];",
              "",
              "const mutuallyExclusiveVars = [",
              "    \"retail_user_member_number\",",
              "    \"retail_user_login_id\"",
              "];",
              "",
              "const missingVars = requiredVars.filter(varName => !pm.environment.get(varName));",
              "",
              "// Check that at least one of the mutually exclusive variables is present",
              "const hasAtLeastOne = mutuallyExclusiveVars.some(varName => pm.environment.get(varName));",
              "if (!hasAtLeastOne) {",
              "    missingVars.push(\"retail_user_member_number or retail_user_login_id (at least one required)\");",
              "}",
              "",
              "if (missingVars.length > 0) {",
              "    throw new Error(",
              "        `Missing required environment variables: ${missingVars.join(\", \")}. Please set them in the active environment before running requests.`",
              "    );",
              "}"
            ]
          }
        }
      ]
    },
