        "exec": [
          "const moment = require('moment');",
          "const startDate = moment().subtract(30, 'days').format('YYYY-MM-DD') + \"T00:00:00.000Z\";",
          "const endDate = moment().format('YYYY-MM-DD') + \"T00:00:00.000Z\";",
          "",
          "pm.environment.set('end_date', endDate);",
          "pm.environment.set('start_date', startDate);",
          "",
          "// Pre-request script to check for required environment variables at the collection level",
          "const requiredVars = [",
          "    \"apigee_base_url\",",
          "    \"client_id\",",
          "    \"client_secret\",",
          "    \"institution_id\"",
          "];",
          "",
          "const missingVars = requiredVars.filter(varName => !pm.environment.get(varName));",
          "",
          "if (missingVars.length > 0) {",
          "    throw new Error(",
          "        `Missing required environment variables: ${missingVars.join(\", \")}. Please set them in the active environment before running requests.`",
          "    );",
          "}"
        ]
      }
    }
  ]
}
