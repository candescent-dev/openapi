          "response": []
        },
        {
          "name": "2b. [Option 2] Search Banking Activities - Next Page Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "",
                  "const baseUrl = pm.environment.get(\"apigee_base_url\");",
                  "const accessToken = pm.environment.get(\"access_token\");",
                  "const startDate = pm.environment.get(\"start_date\");",
                  "const endDate = pm.environment.get(\"end_date\");",
                  "",
                  "const requestOptions = {",
                  "    url: baseUrl + \"/v1/banking-activities\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "        \"Authorization\": \"Bearer \" + accessToken,",
                  "        \"transactionId\": pm.variables.replaceIn(\"{{$guid}}\"),",
                  "        \"Accept\": \"application/json\",",
                  "        \"Content-Type\": \"application/json\"",
                  "    },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            startTime: startDate,",
                  "            endTime: endDate",
                  "        })",
                  "    }",
                  "};",
                  "",
                  "pm.sendRequest(requestOptions, function (error, response) {",
                  "    if (error) {",
                  "        console.error(\"Error calling banking activities API:\", error);",
                  "        return;",
                  "    }",
                  "",
                  "    let responseJson;",
                  "",
                  "    try {",
                  "        responseJson = response.json();",
                  "    } catch (parseError) {",
                  "        console.error(\"Failed to parse response:\", parseError);",
                  "        return;",
                  "    }",
                  "",
                  "    const nextPageToken = responseJson.nextPageToken;",
                  "",
                  "    if (nextPageToken) {",
                  "        pm.environment.set(\"next_page_token\", nextPageToken);",
                  "    } else {",
                  "        console.error(\"nextPageToken not found in response:\", JSON.stringify(responseJson));",
                  "    }",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "transactionId",
                "value": "{{$guid}}",
                "type": "text"
              },
