                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"startTime\": \"{{start_date}}\",\n    \"endTime\": \"{{end_date}}\",\n    \"nextPageToken\": \"{{next_page_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apigee_base_url}}/v1/banking-activities",
              "host": [
                "{{apigee_base_url}}"
              ],
              "path": [
                "v1",
                "banking-activities"
